// ============================================================
//  5주차 디지털필터(시간영역) 실습
//  Step 1 — 극성 자가진단 (교재 슬라이드 8)
// ------------------------------------------------------------
//  목적 : 전극이 제대로 붙었는지, R파가 "위로" 솟는지 확인
//  실행 : 업로드 → Tools → Serial Plotter (Ctrl+Shift+L), 115200
//  판정 : 기준선 위로 뾰족하게 솟는 R파      → 정상
//         기준선 아래로 뾰족하게 향하는 R파  → 뒤집힘
//         뒤집혀 있다면 IN+(오른팔)와 IN−(왼팔) 전극을 서로 바꿔 붙이고
//         다시 확인 (REF는 그대로)
//  ※ 기준은 배선표의 색깔이 아니라 "내 화면에서 R파가 위로 솟는지"
//  ※ 확인이 끝나면 이 코드는 지우고 Step 2(Moving Average)로 넘어갑니다
// ============================================================

const int ADC_PIN = 34;   // GPIO34 (ADC1) — BioAmp EXG Pill OUT

void setup() {
  Serial.begin(115200);
}

void loop() {
  int raw = analogRead(ADC_PIN);
  Serial.println(raw);
  delay(4);   // 극성 확인용 임시 코드 (약 250Hz)
}
